# "replay" plays back recordings from public/recordings (made by `pnpm record:demo`), no server needed.
# "mock" runs entirely in the browser with scripted events (no real proofs).
# "http" talks to the demo server from docs/ui/contract.md through the /api proxy.
VITE_API_MODE=mock
# Where the Vite dev proxy forwards /api (the demo server listens on localhost only).
VITE_API_PROXY=http://127.0.0.1:8787
