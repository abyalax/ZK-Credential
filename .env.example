# Local chain configuration (P4.5). Copy to .env after `pnpm chain:node` + `pnpm chain:deploy`.
# These values are only for the local Hardhat network; never put real keys here.
CHAIN_RPC_URL=http://127.0.0.1:8545
# Contract addresses printed by `pnpm chain:deploy`
ISSUER_REGISTRY_ADDRESS=
CREDENTIAL_VERIFIER_ADDRESS=
# Registry owner account, needed only to register issuers (Hardhat dev account #0 by default)
REGISTRY_OWNER_PRIVATE_KEY=
